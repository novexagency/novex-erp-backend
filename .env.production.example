NODE_ENV=production
PORT=4000

# Neon pooled or direct with TLS required
DATABASE_URL="postgresql://neondb_owner:REPLACE@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

COOKIE_SECURE=true
# Use "none" when frontend and API are on different sites (e.g. Vercel + API host)
COOKIE_SAME_SITE=none
ACCESS_COOKIE_NAME=novex_access
REFRESH_COOKIE_NAME=novex_refresh
TENANT_COOKIE_NAME=novex_tenant

# HTTPS origins only (no http:// except localhost for emergency diagnostics)
CORS_ORIGIN=https://novexerp.vercel.app

SEED_ADMIN_EMAIL=admin@your-company.com
SEED_ADMIN_PASSWORD=REPLACE_STRONG_PASSWORD
SEED_ADMIN_NAME=Novex Admin

CLOUDINARY_CLOUD_NAME=REPLACE
CLOUDINARY_API_KEY=REPLACE
CLOUDINARY_API_SECRET=REPLACE
CLOUDINARY_FOLDER=novex-erp

PLATFORM_SERVICE_KEY=REPLACE_MIN_16_CHARS_RANDOM

BACKUP_DIR=/var/backups/novex-erp
BACKUP_RETENTION_DAYS=30
