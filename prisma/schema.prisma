}

model StockCount {
  id               String         @id @default(uuid())
  organizationId   String
  warehouseId      String
  code             String
  status           StockDocStatus @default(DRAFT)
  notes            String?
  countedAt        DateTime?
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  postedAt         DateTime?
  postedByUserId   String?
  createdByUserId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines            StockCountLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("stock_counts")
}

model StockCountLine {
  id               String     @id @default(uuid())
  organizationId   String
  stockCountId     String
  productId        String
  systemQuantity   Decimal    @db.Decimal(18, 4)
  countedQuantity  Decimal?   @db.Decimal(18, 4)
  difference       Decimal?   @db.Decimal(18, 4)
  unitCost         Decimal?   @db.Decimal(18, 4)
  note             String?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockCount       StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  product          Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productId])
  @@index([organizationId])
  @@map("stock_count_lines")
}

/// Sales issue document — Sales phase can set salesOrderId later.
model StockIssue {
  id              String         @id @default(uuid())
  organizationId  String
  warehouseId     String
  code            String
  status          StockDocStatus @default(DRAFT)
  /// Future Sales module link
  salesOrderId    String?
  customerId      String?
  reservationId   String?
  reason          String?
  notes           String?
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines           StockIssueLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([salesOrderId])
  @@map("stock_issues")
}

model StockIssueLine {
  id             String     @id @default(uuid())
  organizationId String
  stockIssueId   String
  productId      String
  quantity       Decimal    @db.Decimal(18, 4)
  unitCost       Decimal?   @db.Decimal(18, 4)
  inventoryLotId String?
  note           String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockIssue     StockIssue @relation(fields: [stockIssueId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([stockIssueId])
  @@map("stock_issue_lines")
}

/// Sales return document — Sales phase can set salesReturnId later.
model StockReturn {
  id              String         @id @default(uuid())
  organizationId  String
  warehouseId     String
  code            String
  status          StockDocStatus @default(DRAFT)
  salesReturnId   String?
  customerId      String?
  stockIssueId    String?
  reason          String?
  notes           String?
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines           StockReturnLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("stock_returns")
}

model StockReturnLine {
  id             String      @id @default(uuid())
  organizationId String
  stockReturnId  String
  productId      String
  quantity       Decimal     @db.Decimal(18, 4)
  unitCost       Decimal?    @db.Decimal(18, 4)
  batchNumber    String?
  expiryDate     DateTime?
  note           String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockReturn    StockReturn @relation(fields: [stockReturnId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([stockReturnId])
  @@map("stock_return_lines")
}

/// Soft reserve for sales orders — does not change on-hand until issue posts.
model StockReservation {
  id              String                 @id @default(uuid())
  organizationId  String
  warehouseId     String
  code            String
  status          StockReservationStatus @default(ACTIVE)
  salesOrderId    String?
  customerId      String?
  expiresAt       DateTime?
  notes           String?
  createdByUserId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse       Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines           StockReservationLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([salesOrderId])
  @@map("stock_reservations")
}

model StockReservationLine {
  id              String           @id @default(uuid())
  organizationId  String
  reservationId   String
  productId       String
  quantity        Decimal          @db.Decimal(18, 4)
  quantityReleased Decimal         @default(0) @db.Decimal(18, 4)
  quantityConsumed Decimal         @default(0) @db.Decimal(18, 4)
  note            String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservation     StockReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([reservationId])
  @@map("stock_reservation_lines")
}

// ----------------------------------------------------
// SUPPLIERS & PROCUREMENT (Phase 07)
// ----------------------------------------------------

enum SupplierLedgerType {
  OPENING
  PURCHASE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  ADJUSTMENT
}

enum PurchaseDocStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  POSTED
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

model SupplierCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  nameAr         String?
  code           String?
  status         MasterStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suppliers      Supplier[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("supplier_categories")
}

model Supplier {
  id                 String           @id @default(uuid())
  organizationId     String
  code               String
  name               String
  nameAr             String?
  email              String?
  phone              String?
  phoneSecondary     String?
  website            String?
  taxNumber          String?
  commercialRegister String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  country            String           @default("Egypt")
  postalCode         String?
  categoryId         String?
  paymentTermsDays   Int              @default(0)
  creditLimit        Decimal          @default(0) @db.Decimal(18, 4)
  openingBalance     Decimal          @default(0) @db.Decimal(18, 4)
  internalNotes      String?
  status             MasterStatus     @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           SupplierCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ledgerEntries      SupplierLedgerEntry[]
  purchaseOrders     PurchaseOrder[]
  purchaseInvoices   PurchaseInvoice[]
  supplierPayments   SupplierPayment[]
  purchaseReturns    PurchaseReturn[]
  finPayments        FinPayment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
  @@index([name])
  @@map("suppliers")
}

model SupplierLedgerEntry {
  id             String             @id @default(uuid())
  organizationId String
  supplierId     String
  type           SupplierLedgerType
  amount         Decimal            @db.Decimal(18, 4)
  direction      String             @default("CREDIT") // CREDIT increases payable; DEBIT decreases
  reference      String?
  referenceType  String?
  referenceId    String?
  note           String?
  entryDate      DateTime           @default(now())
  createdByUserId String?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@index([entryDate])
  @@index([type])
  @@map("supplier_ledger_entries")
}

model PurchaseRequest {
  id              String            @id @default(uuid())
  organizationId  String
  code            String
  status          PurchaseDocStatus @default(DRAFT)
  requestedByUserId String?
  approvedByUserId String?
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  neededBy        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines           PurchaseRequestLine[]
  purchaseOrders  PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id             String          @id @default(uuid())
  organizationId String
  requestId      String
  productId      String
  quantity       Decimal         @db.Decimal(18, 4)
  notes          String?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request        PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([requestId])
  @@map("purchase_request_lines")
}

model PurchaseOrder {
  id                   String            @id @default(uuid())
  organizationId       String
  code                 String
  supplierId           String
  purchaseRequestId    String?
  status               PurchaseDocStatus @default(DRAFT)
  expectedDeliveryDate DateTime?
  notes                String?
  subtotal             Decimal           @default(0) @db.Decimal(18, 4)
  discountAmount       Decimal           @default(0) @db.Decimal(18, 4)
  taxAmount            Decimal           @default(0) @db.Decimal(18, 4)
  totalAmount          Decimal           @default(0) @db.Decimal(18, 4)
  issuedAt             DateTime?
  issuedByUserId       String?
  createdByUserId      String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier             Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseRequest      PurchaseRequest?  @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  lines                PurchaseOrderLine[]
  attachments          PurchaseOrderAttachment[]
  goodsReceipts        GoodsReceipt[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseReturns      PurchaseReturn[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  organizationId  String
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(18, 4)
  quantityReceived Decimal      @default(0) @db.Decimal(18, 4)
  unitPrice       Decimal       @default(0) @db.Decimal(18, 4)
  discountPercent Decimal       @default(0) @db.Decimal(7, 4)
  discountAmount  Decimal       @default(0) @db.Decimal(18, 4)
  taxPercent      Decimal       @default(0) @db.Decimal(7, 4)
  taxAmount       Decimal       @default(0) @db.Decimal(18, 4)
  lineSubtotal    Decimal       @default(0) @db.Decimal(18, 4)
  lineTotal       Decimal       @default(0) @db.Decimal(18, 4)
  notes           String?

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  goodsReceiptLines GoodsReceiptLine[]
  purchaseReturnLines PurchaseReturnLine[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

model PurchaseOrderAttachment {
  id              String        @id @default(uuid())
  organizationId  String
  purchaseOrderId String
  publicId        String
  secureUrl       String
  resourceType    String        @default("raw")
  fileName        String?
  bytes           Int?
  createdAt       DateTime      @default(now())

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("purchase_order_attachments")
}

model GoodsReceipt {
  id              String            @id @default(uuid())
  organizationId  String
  code            String
  purchaseOrderId String
  warehouseId     String
  status          PurchaseDocStatus @default(DRAFT)
  /// When true, lines may exceed remaining PO qty (authorized over-receive)
  allowOverReceive Boolean          @default(false)
  notes           String?
  receivedAt      DateTime?
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines           GoodsReceiptLine[]
  purchaseReturns PurchaseReturn[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                 String         @id @default(uuid())
  organizationId     String
  goodsReceiptId     String
  purchaseOrderLineId String
  productId          String
  quantityOrdered    Decimal        @db.Decimal(18, 4)
  quantityReceived   Decimal        @db.Decimal(18, 4)
  unitCost           Decimal        @default(0) @db.Decimal(18, 4)
  notes              String?

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceipt       GoodsReceipt   @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine  PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@map("goods_receipt_lines")
}

model PurchaseInvoice {
  id              String            @id @default(uuid())
  organizationId  String
  code            String
  supplierId      String
  purchaseOrderId String?
  supplierInvoiceNo String?
  status          PurchaseDocStatus @default(DRAFT)
  paymentStatus   PaymentStatus     @default(UNPAID)
  invoiceDate     DateTime          @default(now())
  dueDate         DateTime?
  subtotal        Decimal           @default(0) @db.Decimal(18, 4)
  discountAmount  Decimal           @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal           @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal           @default(0) @db.Decimal(18, 4)
  amountPaid      Decimal           @default(0) @db.Decimal(18, 4)
  notes           String?
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines           PurchaseInvoiceLine[]
  paymentAllocations SupplierPaymentAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id               String          @id @default(uuid())
  organizationId   String
  purchaseInvoiceId String
  productId        String?
  description      String?
  quantity         Decimal         @db.Decimal(18, 4)
  unitPrice        Decimal         @default(0) @db.Decimal(18, 4)
  discountPercent  Decimal         @default(0) @db.Decimal(7, 4)
  discountAmount   Decimal         @default(0) @db.Decimal(18, 4)
  taxPercent       Decimal         @default(0) @db.Decimal(7, 4)
  taxAmount        Decimal         @default(0) @db.Decimal(18, 4)
  lineSubtotal     Decimal         @default(0) @db.Decimal(18, 4)
  lineTotal        Decimal         @default(0) @db.Decimal(18, 4)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseInvoice  PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_lines")
}

model SupplierPayment {
  id              String       @id @default(uuid())
  organizationId  String
  code            String
  supplierId      String
  amount          Decimal      @db.Decimal(18, 4)
  paymentMethod   String?
  reference       String?
  paymentDate     DateTime     @default(now())
  notes           String?
  status          String       @default("POSTED") // DRAFT | POSTED | VOID
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations     SupplierPaymentAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([supplierId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id               String          @id @default(uuid())
  organizationId   String
  paymentId        String
  purchaseInvoiceId String
  amount           Decimal         @db.Decimal(18, 4)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment          SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchaseInvoice  PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([paymentId])
  @@index([purchaseInvoiceId])
  @@map("supplier_payment_allocations")
}

model PurchaseReturn {
  id              String            @id @default(uuid())
  organizationId  String
  code            String
  supplierId      String
  purchaseOrderId String?
  goodsReceiptId  String?
  warehouseId     String
  status          PurchaseDocStatus @default(DRAFT)
  reason          String?
  notes           String?
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt    GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  warehouse       Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines           PurchaseReturnLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id                  String         @id @default(uuid())
  organizationId      String
  purchaseReturnId    String
  productId           String
  purchaseOrderLineId String?
  quantity            Decimal        @db.Decimal(18, 4)
  unitCost            Decimal        @default(0) @db.Decimal(18, 4)
  notes               String?

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseReturn      PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([purchaseReturnId])
  @@map("purchase_return_lines")
}

// ----------------------------------------------------
// SALES MANAGEMENT & INVOICING (Phase 09)
// No e-invoicing / payment gateways. Print-ready invoice payload API.
// ----------------------------------------------------

enum SalesDocStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
  CONFIRMED
  RESERVED
  PARTIALLY_DELIVERED
  DELIVERED
  INVOICED
  POSTED
  CANCELLED
  CLOSED
}

enum SalesPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model PriceList {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  currency       String       @default("EGP")
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PriceListItem[]
  customers      Customer[]
  quotations     SalesQuotation[]
  salesOrders    SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("price_lists")
}

model PriceListItem {
  id             String    @id @default(uuid())
  organizationId String
  priceListId    String
  productId      String
  unitPrice      Decimal   @db.Decimal(18, 4)
  minQty         Decimal   @default(1) @db.Decimal(18, 4)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceList      PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([organizationId])
  @@map("price_list_items")
}

model CustomerPriceOverride {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String
  productId      String
  unitPrice      Decimal   @db.Decimal(18, 4)
  discountPercent Decimal  @default(0) @db.Decimal(7, 4)
  validFrom      DateTime?
  validTo        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([organizationId])
  @@map("customer_price_overrides")
}

model DiscountRule {
  id             String    @id @default(uuid())
  organizationId String
  code           String
  name           String
  percent        Decimal   @db.Decimal(7, 4)
  maxPercent     Decimal?  @db.Decimal(7, 4)
  requiresAuth   Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("discount_rules")
}

model SalesQuotation {
  id              String         @id @default(uuid())
  organizationId  String
  code            String
  customerId      String
  priceListId     String?
  status          SalesDocStatus @default(DRAFT)
  expiresAt       DateTime?
  notes           String?
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  discountAmount  Decimal        @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal        @default(0) @db.Decimal(18, 4)
  convertedOrderId String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  priceList       PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  lines           SalesQuotationLine[]
  salesOrders     SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@map("sales_quotations")
}

model SalesQuotationLine {
  id              String         @id @default(uuid())
  organizationId  String
  quotationId     String
  productId       String
  quantity        Decimal        @db.Decimal(18, 4)
  unitPrice       Decimal        @default(0) @db.Decimal(18, 4)
  listPrice       Decimal?       @db.Decimal(18, 4)
  manualPrice     Boolean        @default(false)
  discountPercent Decimal        @default(0) @db.Decimal(7, 4)
  discountAmount  Decimal        @default(0) @db.Decimal(18, 4)
  taxPercent      Decimal        @default(0) @db.Decimal(7, 4)
  taxAmount       Decimal        @default(0) @db.Decimal(18, 4)
  lineSubtotal    Decimal        @default(0) @db.Decimal(18, 4)
  lineTotal       Decimal        @default(0) @db.Decimal(18, 4)
  notes           String?

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotation       SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product         Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([quotationId])
  @@map("sales_quotation_lines")
}

model SalesOrder {
  id                 String         @id @default(uuid())
  organizationId     String
  code               String
  customerId         String
  quotationId        String?
  priceListId        String?
  status             SalesDocStatus @default(DRAFT)
  reservationStatus  String         @default("NONE") // NONE | RESERVED | RELEASED
  deliveryStatus     String         @default("PENDING") // PENDING | PARTIAL | DELIVERED
  reservationId      String?
  notes              String?
  promisedDeliveryAt DateTime?
  subtotal           Decimal        @default(0) @db.Decimal(18, 4)
  discountAmount     Decimal        @default(0) @db.Decimal(18, 4)
  taxAmount          Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount        Decimal        @default(0) @db.Decimal(18, 4)
  confirmedAt        DateTime?
  createdByUserId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation          SalesQuotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  priceList          PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  lines              SalesOrderLine[]
  invoices           SalesInvoice[]
  salesReturns       SalesReturn[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                String     @id @default(uuid())
  organizationId    String
  salesOrderId      String
  productId         String
  quantity          Decimal    @db.Decimal(18, 4)
  quantityReserved  Decimal    @default(0) @db.Decimal(18, 4)
  quantityDelivered Decimal    @default(0) @db.Decimal(18, 4)
  quantityInvoiced  Decimal    @default(0) @db.Decimal(18, 4)
  unitPrice         Decimal    @default(0) @db.Decimal(18, 4)
  listPrice         Decimal?   @db.Decimal(18, 4)
  manualPrice       Boolean    @default(false)
  discountPercent   Decimal    @default(0) @db.Decimal(7, 4)
  discountAmount    Decimal    @default(0) @db.Decimal(18, 4)
  taxPercent        Decimal    @default(0) @db.Decimal(7, 4)
  taxAmount         Decimal    @default(0) @db.Decimal(18, 4)
  lineSubtotal      Decimal    @default(0) @db.Decimal(18, 4)
  lineTotal         Decimal    @default(0) @db.Decimal(18, 4)
  notes             String?

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder        SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product           Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  invoiceLines      SalesInvoiceLine[]
  returnLines       SalesReturnLine[]

  @@index([organizationId])
  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model SalesInvoice {
  id              String             @id @default(uuid())
  organizationId  String
  code            String
  customerId      String
  salesOrderId    String?
  status          SalesDocStatus     @default(DRAFT)
  paymentStatus   SalesPaymentStatus @default(UNPAID)
  invoiceDate     DateTime           @default(now())
  dueDate         DateTime?
  notes           String?
  subtotal        Decimal            @default(0) @db.Decimal(18, 4)
  discountAmount  Decimal            @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal            @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal            @default(0) @db.Decimal(18, 4)
  amountPaid      Decimal            @default(0) @db.Decimal(18, 4)
  postedAt        DateTime?
  postedByUserId  String?
  cancelledAt     DateTime?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?        @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  lines           SalesInvoiceLine[]
  receiptAllocations CustomerReceiptAllocation[]
  salesReturns    SalesReturn[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id              String       @id @default(uuid())
  organizationId  String
  salesInvoiceId  String
  salesOrderLineId String?
  productId       String
  description     String?
  quantity        Decimal      @db.Decimal(18, 4)
  unitPrice       Decimal      @default(0) @db.Decimal(18, 4)
  discountPercent Decimal      @default(0) @db.Decimal(7, 4)
  discountAmount  Decimal      @default(0) @db.Decimal(18, 4)
  taxPercent      Decimal      @default(0) @db.Decimal(7, 4)
  taxAmount       Decimal      @default(0) @db.Decimal(18, 4)
  lineSubtotal    Decimal      @default(0) @db.Decimal(18, 4)
  lineTotal       Decimal      @default(0) @db.Decimal(18, 4)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  salesOrderLine  SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  product         Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([salesInvoiceId])
  @@map("sales_invoice_lines")
}

model CustomerReceipt {
  id              String       @id @default(uuid())
  organizationId  String
  code            String
  customerId      String
  amount          Decimal      @db.Decimal(18, 4)
  paymentMethod   String?
  reference       String?
  receiptDate     DateTime     @default(now())
  notes           String?
  status          String       @default("POSTED") // DRAFT | POSTED | VOID
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations     CustomerReceiptAllocation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([customerId])
  @@map("customer_receipts")
}

model CustomerReceiptAllocation {
  id             String          @id @default(uuid())
  organizationId String
  receiptId      String
  salesInvoiceId String
  amount         Decimal         @db.Decimal(18, 4)

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt        CustomerReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  salesInvoice   SalesInvoice    @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([receiptId])
  @@index([salesInvoiceId])
  @@map("customer_receipt_allocations")
}

model SalesReturn {
  id              String         @id @default(uuid())
  organizationId  String
  code            String
  customerId      String
  salesOrderId    String?
  salesInvoiceId  String?
  stockReturnId   String?
  status          SalesDocStatus @default(DRAFT)
  reason          String?
  notes           String?
  subtotal        Decimal        @default(0) @db.Decimal(18, 4)
  taxAmount       Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount     Decimal        @default(0) @db.Decimal(18, 4)
  creditAmount    Decimal        @default(0) @db.Decimal(18, 4)
  postedAt        DateTime?
  postedByUserId  String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  salesInvoice    SalesInvoice?  @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  lines           SalesReturnLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@map("sales_returns")
}

model SalesReturnLine {
  id               String      @id @default(uuid())
  organizationId   String
  salesReturnId    String
  productId        String
  salesOrderLineId String?
  quantity         Decimal     @db.Decimal(18, 4)
  unitPrice        Decimal     @default(0) @db.Decimal(18, 4)
  taxPercent       Decimal     @default(0) @db.Decimal(7, 4)
  taxAmount        Decimal     @default(0) @db.Decimal(18, 4)
  lineTotal        Decimal     @default(0) @db.Decimal(18, 4)
  notes            String?

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesReturn      SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  salesOrderLine   SalesOrderLine? @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([salesReturnId])
  @@map("sales_return_lines")
}

// ----------------------------------------------------
// POINT OF SALE & CASHIER (Phase 10)
// Dedicated POS tickets. No payment gateways.
// ----------------------------------------------------

enum CashierSessionStatus {
  OPEN
  PENDING_APPROVAL
  CLOSED
  CANCELLED
}

enum PosSaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PosSaleType {
  SALE
  REFUND
}

model PosReceiptConfig {
  id               String       @id @default(uuid())
  organizationId   String
  name             String       @default("Default")
  isDefault        Boolean      @default(true)
  showLogo         Boolean      @default(true)
  showTaxNumber    Boolean      @default(true)
  showAddress      Boolean      @default(true)
  headerText       String?
  headerTextAr     String?
  footerText       String?
  footerTextAr     String?
  paperWidthMm     Int          @default(80)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("pos_receipt_configs")
}

model CashierSession {
  id                    String               @id @default(uuid())
  organizationId        String
  code                  String
  status                CashierSessionStatus @default(OPEN)
  cashierUserId         String
  openedAt              DateTime             @default(now())
  closedAt              DateTime?
  openingCash           Decimal              @default(0) @db.Decimal(18, 4)
  expectedCash          Decimal?             @db.Decimal(18, 4)
  actualCash            Decimal?             @db.Decimal(18, 4)
  cashDifference        Decimal?             @db.Decimal(18, 4)
  totalSales            Decimal              @default(0) @db.Decimal(18, 4)
  totalCashSales        Decimal              @default(0) @db.Decimal(18, 4)
  totalCardSales        Decimal              @default(0) @db.Decimal(18, 4)
  totalCreditSales      Decimal              @default(0) @db.Decimal(18, 4)
  totalRefunds          Decimal              @default(0) @db.Decimal(18, 4)
  totalCashIn           Decimal              @default(0) @db.Decimal(18, 4)
  totalCashOut          Decimal              @default(0) @db.Decimal(18, 4)
  notes                 String?
  discrepancyReason     String?
  approvedByUserId      String?
  approvedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashMovements         CashMovement[]
  sales                 PosSale[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([cashierUserId])
  @@index([status])
  @@map("cashier_sessions")
}

model CashMovement {
  id              String         @id @default(uuid())
  organizationId  String
  sessionId       String
  type            String         // CASH_IN | CASH_OUT
  amount          Decimal        @db.Decimal(18, 4)
  reason          String?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session         CashierSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sessionId])
  @@map("cash_movements")
}

model PosSale {
  id               String        @id @default(uuid())
  organizationId   String
  code             String
  sessionId        String
  customerId       String?
  type             PosSaleType   @default(SALE)
  status           PosSaleStatus @default(COMPLETED)
  /// Idempotency key from client — prevents duplicate checkout
  clientRequestId  String?
  stockIssueId     String?
  stockReturnId    String?
  originalSaleId   String?
  allowCredit      Boolean       @default(false)
  discountAuthorized Boolean     @default(false)
  subtotal         Decimal       @default(0) @db.Decimal(18, 4)
  discountAmount   Decimal       @default(0) @db.Decimal(18, 4)
  taxAmount        Decimal       @default(0) @db.Decimal(18, 4)
  totalAmount      Decimal       @default(0) @db.Decimal(18, 4)
  amountPaid       Decimal       @default(0) @db.Decimal(18, 4)
  amountCredit     Decimal       @default(0) @db.Decimal(18, 4)
  changeGiven      Decimal       @default(0) @db.Decimal(18, 4)
  notes            String?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancelReason     String?
  cashierUserId    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session          CashierSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines            PosSaleLine[]
  payments         PosPayment[]
  events           PosSaleEvent[]
  originalSale     PosSale?      @relation("PosRefunds", fields: [originalSaleId], references: [id], onDelete: SetNull)
  refunds          PosSale[]     @relation("PosRefunds")

  @@unique([organizationId, code])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId])
  @@index([sessionId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("pos_sales")
}

model PosSaleLine {
  id              String   @id @default(uuid())
  organizationId  String
  posSaleId       String
  productId       String
  barcode         String?
  quantity        Decimal  @db.Decimal(18, 4)
  unitPrice       Decimal  @db.Decimal(18, 4)
  listPrice       Decimal? @db.Decimal(18, 4)
  discountPercent Decimal  @default(0) @db.Decimal(7, 4)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 4)
  taxPercent      Decimal  @default(0) @db.Decimal(7, 4)
  taxAmount       Decimal  @default(0) @db.Decimal(18, 4)
  lineSubtotal    Decimal  @default(0) @db.Decimal(18, 4)
  lineTotal       Decimal  @default(0) @db.Decimal(18, 4)

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posSale         PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([posSaleId])
  @@map("pos_sale_lines")
}

model PosPayment {
  id              String   @id @default(uuid())
  organizationId  String
  posSaleId       String
  methodCode      String   // CASH | CARD | TRANSFER | OTHER | CREDIT
  methodName      String?
  amount          Decimal  @db.Decimal(18, 4)
  reference       String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posSale         PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([posSaleId])
  @@map("pos_payments")
}

model PosSaleEvent {
  id              String   @id @default(uuid())
  organizationId  String
  posSaleId       String
  action          String   // CREATED | CANCELLED | REFUND | DISCOUNT_AUTH | PRINT
  note            String?
  userId          String?
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posSale         PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([posSaleId])
  @@map("pos_sale_events")
}

// ----------------------------------------------------
// FINANCIAL MANAGEMENT / TREASURY (Phase 11)
// Cashbook model — no external banks, no full GL yet.
// Posted history is immutable; cancel/reverse via reversing movements.
// ----------------------------------------------------

enum FinDocStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  CANCELLED
}

enum TreasuryDirection {
  IN
  OUT
}

enum TreasuryMovementType {
  OPENING
  RECEIPT
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  DEPOSIT
  WITHDRAWAL
  EXPENSE
  ADJUSTMENT
  REVERSAL
}

model Cashbox {
  id               String       @id @default(uuid())
  organizationId   String
  code             String
  name             String
  nameAr           String?
  currency         String       @default("EGP")
  openingBalance   Decimal      @default(0) @db.Decimal(18, 4)
  currentBalance   Decimal      @default(0) @db.Decimal(18, 4)
  isActive         Boolean      @default(true)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements        TreasuryMovement[]
  transfersFrom    TreasuryTransfer[] @relation("TransferFromCashbox")
  transfersTo      TreasuryTransfer[] @relation("TransferToCashbox")
  receipts         FinReceipt[]
  payments         FinPayment[]
  expenses         Expense[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("cashboxes")
}

model BankAccount {
  id               String       @id @default(uuid())
  organizationId   String
  code             String
  name             String
  nameAr           String?
  bankName         String?
  accountNumber    String?
  iban             String?
  currency         String       @default("EGP")
  openingBalance   Decimal      @default(0) @db.Decimal(18, 4)
  currentBalance   Decimal      @default(0) @db.Decimal(18, 4)
  isActive         Boolean      @default(true)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements        TreasuryMovement[]
  transfersFrom    TreasuryTransfer[] @relation("TransferFromBank")
  transfersTo      TreasuryTransfer[] @relation("TransferToBank")
  receipts         FinReceipt[]
  payments         FinPayment[]
  expenses         Expense[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("bank_accounts")
}

/// Immutable treasury ledger for cashboxes and bank accounts.
model TreasuryMovement {
  id               String               @id @default(uuid())
  organizationId   String
  accountType      String               // CASHBOX | BANK
  cashboxId        String?
  bankAccountId    String?
  type             TreasuryMovementType
  direction        TreasuryDirection
  amount           Decimal              @db.Decimal(18, 4)
  previousBalance  Decimal              @db.Decimal(18, 4)
  resultingBalance Decimal              @db.Decimal(18, 4)
  referenceType    String
  referenceId      String
  referenceCode    String?
  sourceLineId     String               @unique
  note             String?
  entryDate        DateTime             @default(now())
  postedByUserId   String?
  postedAt         DateTime             @default(now())
  reversesMovementId String?
  createdAt        DateTime             @default(now())

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashbox          Cashbox?             @relation(fields: [cashboxId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([cashboxId])
  @@index([bankAccountId])
  @@index([entryDate])
  @@index([referenceType, referenceId])
  @@map("treasury_movements")
}

model TreasuryTransfer {
  id               String       @id @default(uuid())
  organizationId   String
  code             String
  status           FinDocStatus @default(DRAFT)
  amount           Decimal      @db.Decimal(18, 4)
  fromCashboxId    String?
  toCashboxId      String?
  fromBankAccountId String?
  toBankAccountId  String?
  note             String?
  clientRequestId  String?
  postedAt         DateTime?
  postedByUserId   String?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancelReason     String?
  createdByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromCashbox      Cashbox?     @relation("TransferFromCashbox", fields: [fromCashboxId], references: [id], onDelete: Restrict)
  toCashbox        Cashbox?     @relation("TransferToCashbox", fields: [toCashboxId], references: [id], onDelete: Restrict)
  fromBankAccount  BankAccount? @relation("TransferFromBank", fields: [fromBankAccountId], references: [id], onDelete: Restrict)
  toBankAccount    BankAccount? @relation("TransferToBank", fields: [toBankAccountId], references: [id], onDelete: Restrict)

  @@unique([organizationId, code])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId])
  @@index([status])
  @@map("treasury_transfers")
}

model CostCenter {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  recurringExpenses RecurringExpense[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("cost_centers")
}

model Expense {
  id               String       @id @default(uuid())
  organizationId   String
  code             String
  categoryId       String
  costCenterId     String?
  status           FinDocStatus @default(DRAFT)
  title            String
  description      String?
  amount           Decimal      @db.Decimal(18, 4)
  taxAmount        Decimal      @default(0) @db.Decimal(18, 4)
  totalAmount      Decimal      @db.Decimal(18, 4)
  expenseDate      DateTime     @default(now())
  cashboxId        String?
  bankAccountId    String?
  vendorName       String?
  notes            String?
  clientRequestId  String?
  approvedAt       DateTime?
  approvedByUserId String?
  postedAt         DateTime?
  postedByUserId   String?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancelReason     String?
  createdByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costCenter       CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  cashbox          Cashbox?     @relation(fields: [cashboxId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  attachments      ExpenseAttachment[]

  @@unique([organizationId, code])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
  @@map("expenses")
}

model ExpenseAttachment {
  id             String   @id @default(uuid())
  organizationId String
  expenseId      String
  publicId       String
  secureUrl      String
  fileName       String?
  bytes          Int?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([expenseId])
  @@map("expense_attachments")
}

model RecurringExpense {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  title          String
  categoryId     String
  costCenterId   String?
  amount         Decimal  @db.Decimal(18, 4)
  /// DAILY | WEEKLY | MONTHLY | YEARLY
  frequency      String   @default("MONTHLY")
  nextRunAt      DateTime?
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costCenter     CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("recurring_expenses")
}

/// Customer receipts (treasury) — supports partial/advance/unallocated + authorized cancel.
model FinReceipt {
  id               String       @id @default(uuid())
  organizationId   String
  code             String
  customerId       String?
  status           FinDocStatus @default(DRAFT)
  amount           Decimal      @db.Decimal(18, 4)
  allocatedAmount  Decimal      @default(0) @db.Decimal(18, 4)
  unallocatedAmount Decimal     @default(0) @db.Decimal(18, 4)
  isAdvance        Boolean      @default(false)
  cashboxId        String?
  bankAccountId    String?
  paymentMethod    String?
  reference        String?
  receiptDate      DateTime     @default(now())
  notes            String?
  clientRequestId  String?
  postedAt         DateTime?
  postedByUserId   String?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancelReason     String?
  cancelAuthorized Boolean      @default(false)
  createdByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashbox          Cashbox?     @relation(fields: [cashboxId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  allocations      FinReceiptAllocation[]

  @@unique([organizationId, code])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId])
  @@index([customerId])
  @@index([status])
  @@map("fin_receipts")
}

model FinReceiptAllocation {
  id             String     @id @default(uuid())
  organizationId String
  receiptId      String
  salesInvoiceId String?
  amount         Decimal    @db.Decimal(18, 4)
  note           String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt        FinReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([receiptId])
  @@map("fin_receipt_allocations")
}

/// Supplier / expense payment vouchers.
model FinPayment {
  id               String       @id @default(uuid())
  organizationId   String
  code             String
  /// SUPPLIER | EXPENSE | ADVANCE
  paymentType      String       @default("SUPPLIER")
  supplierId       String?
  expenseId        String?
  status           FinDocStatus @default(DRAFT)
  amount           Decimal      @db.Decimal(18, 4)
  allocatedAmount  Decimal      @default(0) @db.Decimal(18, 4)
  unallocatedAmount Decimal     @default(0) @db.Decimal(18, 4)
  isAdvance        Boolean      @default(false)
  cashboxId        String?
  bankAccountId    String?
  paymentMethod    String?
  reference        String?
  paymentDate      DateTime     @default(now())
  notes            String?
  clientRequestId  String?
  postedAt         DateTime?
  postedByUserId   String?
  cancelledAt      DateTime?
  cancelledByUserId String?
  cancelReason     String?
  cancelAuthorized Boolean      @default(false)
  createdByUserId  String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  cashbox          Cashbox?     @relation(fields: [cashboxId], references: [id], onDelete: Restrict)
  bankAccount      BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  allocations      FinPaymentAllocation[]

  @@unique([organizationId, code])
  @@unique([organizationId, clientRequestId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("fin_payments")
}

model FinPaymentAllocation {
  id                String     @id @default(uuid())
  organizationId    String
  paymentId         String
  purchaseInvoiceId String?
  amount            Decimal    @db.Decimal(18, 4)
  note              String?

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payment           FinPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([paymentId])
  @@map("fin_payment_allocations")
}

// ----------------------------------------------------
// GENERAL LEDGER / ACCOUNTING ENGINE (Phase 12)
// Double-entry journals; per-event posting rules with autoPost.
// Posted journals immutable — corrections via reversal only.
// Not a tax/regulatory compliance claim.
// ----------------------------------------------------

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum GlAccountStatus {
  ACTIVE
  INACTIVE
}

enum FiscalYearStatus {
  OPEN
  CLOSED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum AccountingEventType {
  SALES_INVOICE
  SALES_RETURN
  PURCHASE_INVOICE
  PURCHASE_RETURN
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
  EXPENSE
  INVENTORY_MOVEMENT
  OPENING_BALANCE
  MANUAL
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum JournalAuditAction {
  CREATED
  REVIEWED
  POSTED
  REVERSED
  RULE_APPLIED
  UPDATED
}

model GlAccount {
  id             String         @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  type           GlAccountType
  parentId       String?
  isPostable     Boolean        @default(true)
  isSystem       Boolean        @default(false)
  status         GlAccountStatus @default(ACTIVE)
  /// Optional role tag for default rule mapping: CASH, BANK, AR, AP, REVENUE, COGS, INVENTORY, EXPENSE, TAX_PAYABLE, EQUITY, OPENING
  systemRole     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         GlAccount?     @relation("GlAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       GlAccount[]    @relation("GlAccountTree")
  journalLines   JournalLine[]

  rulesAsDebitPrimary   AccountingPostingRule[] @relation("RuleDebitPrimary")
  rulesAsCreditPrimary  AccountingPostingRule[] @relation("RuleCreditPrimary")
  rulesAsDebitSecondary AccountingPostingRule[] @relation("RuleDebitSecondary")
  rulesAsCreditSecondary AccountingPostingRule[] @relation("RuleCreditSecondary")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@index([type])
  @@map("gl_accounts")
}

model FiscalYear {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  startDate      DateTime
  endDate        DateTime
  status         FiscalYearStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods        AccountingPeriod[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id             String                 @id @default(uuid())
  organizationId String
  fiscalYearId   String
  code           String
  name           String?
  startDate      DateTime
  endDate        DateTime
  status         AccountingPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  lockedAt       DateTime?
  lockedByUserId String?
  reopenedAt     DateTime?
  reopenedByUserId String?
  reopenReason   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear     FiscalYear             @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  journals       JournalEntry[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([fiscalYearId])
  @@index([status])
  @@map("accounting_periods")
}

/// Per-transaction-type posting configuration (autoPost is per event, not global).
model AccountingPostingRule {
  id                  String              @id @default(uuid())
  organizationId      String
  eventType           AccountingEventType
  autoPost            Boolean             @default(false)
  isActive            Boolean             @default(true)
  isSystemDefault     Boolean             @default(false)
  /// Primary debit account (e.g. AR for sales, Expense for expenses)
  debitAccountId      String?
  /// Primary credit account (e.g. Revenue for sales, Cash for expenses)
  creditAccountId     String?
  /// Optional secondary debit (e.g. COGS, tax)
  debitSecondaryId    String?
  /// Optional secondary credit (e.g. Inventory, tax payable)
  creditSecondaryId   String?
  description         String?
  updatedByUserId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  debitAccount        GlAccount?          @relation("RuleDebitPrimary", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount       GlAccount?          @relation("RuleCreditPrimary", fields: [creditAccountId], references: [id], onDelete: Restrict)
  debitSecondary      GlAccount?          @relation("RuleDebitSecondary", fields: [debitSecondaryId], references: [id], onDelete: Restrict)
  creditSecondary     GlAccount?          @relation("RuleCreditSecondary", fields: [creditSecondaryId], references: [id], onDelete: Restrict)

  @@unique([organizationId, eventType])
  @@index([organizationId])
  @@map("accounting_posting_rules")
}

model JournalEntry {
  id                 String              @id @default(uuid())
  organizationId     String
  code               String
  status             JournalStatus       @default(DRAFT)
  eventType          AccountingEventType @default(MANUAL)
  entryDate          DateTime            @default(now())
  description        String?
  sourceType         String?
  sourceId           String?
  sourceCode         String?
  periodId           String?
  autoGenerated      Boolean             @default(false)
  autoPosted         Boolean             @default(false)
  totalDebit         Decimal             @default(0) @db.Decimal(18, 4)
  totalCredit        Decimal             @default(0) @db.Decimal(18, 4)
  createdByUserId    String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  postedByUserId     String?
  postedAt           DateTime?
  /// If this entry reverses another, points to the original.
  reversesJournalId  String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period             AccountingPeriod?   @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines              JournalLine[]
  auditLogs          JournalAuditLog[]
  reversesJournal    JournalEntry?       @relation("JournalReversal", fields: [reversesJournalId], references: [id], onDelete: Restrict)
  /// Back-relation: the reversal entry that reversed this one.
  reversedByJournal  JournalEntry?       @relation("JournalReversal")

  @@unique([organizationId, code])
  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId])
  @@index([status])
  @@index([entryDate])
  @@index([eventType])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(uuid())
  organizationId String
  journalId      String
  accountId      String
  lineNo         Int
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  memo           String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal        JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account        GlAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

model JournalAuditLog {
  id             String             @id @default(uuid())
  organizationId String
  journalId      String
  action         JournalAuditAction
  userId         String?
  note           String?
  at             DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journal        JournalEntry       @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([journalId])
  @@map("journal_audit_logs")
}

// ----------------------------------------------------
// HUMAN RESOURCES & EMPLOYEE MANAGEMENT (Phase 13)
// Tenant employees only — separate from NOVEX platform / User superadmin staff.
// Optional userId links an employee to ERP login when needed.
// ----------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED
  ARCHIVED
}

enum EmployeeDocType {
  CONTRACT
  ID
  CERTIFICATE
  OTHER
}

enum EmployeeDocVisibility {
  HR_ONLY
  MANAGER
  EMPLOYEE_SELF
}

enum HrRequestType {
  LEAVE
  DOCUMENT
  GENERAL
  INTERNAL
}

enum HrRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum HrApprovalAction {
  SUBMITTED
  REVIEWED
  APPROVED
  REJECTED
  CANCELLED
  COMMENTED
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
  WEEKLY
  DAILY
}

/// Tenant HR employee profile (not a platform User by itself).
model Employee {
  id                 String           @id @default(uuid())
  organizationId     String
  employeeNumber     String
  firstName          String
  lastName           String
  nameAr             String?
  email              String?
  phone              String?
  phoneSecondary     String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  country            String?
  postalCode         String?
  departmentId       String?
  jobTitleId         String?
  branchId           String?
  employmentType     EmploymentType   @default(FULL_TIME)
  status             EmploymentStatus @default(ACTIVE)
  hireDate           DateTime         @default(now())
  terminationDate    DateTime?
  managerEmployeeId  String?
  /// Optional ERP login link — must be a User who can belong to this tenant
  userId             String?
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  notes              String?
  createdByUserId    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department         Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitle           JobTitle?        @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  branch             Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager            Employee?        @relation("EmployeeManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  reports            Employee[]       @relation("EmployeeManager")
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  compensation       EmployeeCompensation?
  documents          EmployeeDocument[]
  teamMemberships    TeamMember[]
  requestsSubmitted  HrRequest[]      @relation("HrRequestRequester")
  requestsAssigned   HrRequest[]      @relation("HrRequestAssignee")
  schedules          EmployeeSchedule[]
  attendanceRecords  AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  payrollLines       PayrollLine[]
  salaryAdvances     SalaryAdvance[]
  // Operations (Phase 15)
  managedProjects    OpsProject[]       @relation("ProjectManager")
  projectMemberships OpsProjectMember[]
  taskAssignments    OpsTaskAssignee[]
  taskComments       OpsTaskComment[]
  assignedAssets     OpsAsset[]         @relation("AssetAssignee")
  maintenanceResponsible OpsMaintenanceRequest[] @relation("MaintenanceResponsible")

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([branchId])
  @@index([status])
  @@index([managerEmployeeId])
  @@map("employees")
}

/// Restricted salary data — require hr:salary / hr:manage to read.
model EmployeeCompensation {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String       @unique
  baseSalary     Decimal      @db.Decimal(18, 4)
  currency       String       @default("EGP")
  payFrequency   PayFrequency @default(MONTHLY)
  effectiveFrom  DateTime     @default(now())
  notes          String?
  updatedByUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("employee_compensations")
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  departmentId   String?
  code           String
  name           String
  nameAr         String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  members        TeamMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(uuid())
  organizationId String
  teamId         String
  employeeId     String
  roleLabel      String?
  isLead         Boolean  @default(false)
  joinedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@index([organizationId])
  @@index([employeeId])
  @@map("team_members")
}

model EmployeeDocument {
  id             String                @id @default(uuid())
  organizationId String
  employeeId     String
  docType        EmployeeDocType       @default(OTHER)
  title          String
  publicId       String
  secureUrl      String
  fileName       String?
  bytes          Int?
  expiresAt      DateTime?
  visibility     EmployeeDocVisibility @default(HR_ONLY)
  notes          String?
  archivedAt     DateTime?
  uploadedByUserId String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([employeeId])
  @@index([docType])
  @@index([expiresAt])
  @@map("employee_documents")
}

model HrRequest {
  id               String          @id @default(uuid())
  organizationId   String
  code             String
  type             HrRequestType   @default(GENERAL)
  status           HrRequestStatus @default(DRAFT)
  title            String
  description      String?
  requesterId      String
  assigneeId       String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  decisionNote     String?
  createdByUserId  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester        Employee        @relation("HrRequestRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee         Employee?       @relation("HrRequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  approvals        HrRequestApproval[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([requesterId])
  @@index([status])
  @@map("hr_requests")
}

model HrRequestApproval {
  id             String           @id @default(uuid())
  organizationId String
  requestId      String
  action         HrApprovalAction
  actorUserId    String?
  actorEmployeeId String?
  note           String?
  at             DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  request        HrRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requestId])
  @@map("hr_request_approvals")
}

// ----------------------------------------------------
// ATTENDANCE, LEAVES & PAYROLL (Phase 14)
// Soft check-in API + device adapter stub (no fingerprint hardware).
// Payroll FINALIZED is immutable. No external payment providers.
// ----------------------------------------------------

enum ScheduleKind {
  FIXED
  SHIFT
  FLEXIBLE
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceSource {
  MANUAL
  SELF_SERVICE
  DEVICE
  SYSTEM
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  IN_REVIEW
  APPROVED
  FINALIZED
  CANCELLED
}

enum PayrollItemKind {
  BASIC
  ALLOWANCE
  BONUS
  OVERTIME
  ADVANCE
  ABSENCE_DEDUCTION
  OTHER_DEDUCTION
  OTHER_EARNING
}

enum AdvanceStatus {
  OPEN
  DEDUCTED
  CANCELLED
}

model WorkSchedule {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  kind           ScheduleKind @default(FIXED)
  /// Bitmask Mon=1 .. Sun=64 for workdays; default Mon-Fri = 31
  workdaysMask   Int          @default(31)
  startTime      String       @default("09:00")
  endTime        String       @default("17:00")
  breakMinutes   Int          @default(60)
  graceMinutes   Int          @default(15)
  expectedHours  Decimal      @default(8) @db.Decimal(6, 2)
  overtimeAfterHours Decimal  @default(8) @db.Decimal(6, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shifts         Shift[]
  assignments    EmployeeSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("work_schedules")
}

model Shift {
  id             String       @id @default(uuid())
  organizationId String
  scheduleId     String
  code           String
  name           String
  startTime      String
  endTime        String
  breakMinutes   Int          @default(0)
  isActive       Boolean      @default(true)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@unique([scheduleId, code])
  @@index([organizationId])
  @@map("shifts")
}

model EmployeeSchedule {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  scheduleId     String
  effectiveFrom  DateTime     @default(now())
  effectiveTo    DateTime?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule       WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([employeeId])
  @@index([scheduleId])
  @@map("employee_schedules")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String
  employeeId     String
  workDate       DateTime         @db.Date
  checkInAt      DateTime?
  checkOutAt     DateTime?
  status         AttendanceStatus @default(PRESENT)
  source         AttendanceSource @default(MANUAL)
  shiftId        String?
  scheduledMinutes Int            @default(0)
  workedMinutes  Int              @default(0)
  lateMinutes    Int              @default(0)
  earlyLeaveMinutes Int           @default(0)
  overtimeMinutes Int             @default(0)
  note           String?
  deviceRef      String?
  createdByUserId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift          Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  corrections    AttendanceCorrection[]

  @@unique([organizationId, employeeId, workDate])
  @@index([organizationId])
  @@index([employeeId])
  @@index([workDate])
  @@index([status])
  @@map("attendance_records")
}

model AttendanceCorrection {
  id             String           @id @default(uuid())
  organizationId String
  attendanceId   String
  employeeId     String
