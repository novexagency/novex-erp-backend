model SalesOpportunity {
  id             String           @id @default(uuid())
  organizationId String
  customerId     String
  title          String
  description    String?
  amount         Decimal?         @db.Decimal(18, 4)
  stage          OpportunityStage @default(NEW)
  expectedCloseAt DateTime?
