  country            String           @default("Egypt")
  postalCode         String?
  categoryId         String?
  groupId            String?
  creditLimit        Decimal          @default(0) @db.Decimal(18, 4)
  paymentTermsDays   Int              @default(0)
  openingBalance     Decimal          @default(0) @db.Decimal(18, 4)
  internalNotes      String?
  status             MasterStatus     @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category           CustomerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  group              CustomerGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  tags               CustomerTagLink[]
  notes              CustomerNote[]
  interactions       CustomerInteraction[]
  followUps          CustomerFollowUp[]
  opportunities      SalesOpportunity[]
  ledgerEntries      CustomerLedgerEntry[]
  priceListId        String?
  priceList          PriceList?        @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  priceOverrides     CustomerPriceOverride[]
  salesQuotations    SalesQuotation[]
  salesOrders        SalesOrder[]
  salesInvoices      SalesInvoice[]
  customerReceipts   CustomerReceipt[]
  salesReturns       SalesReturn[]
  posSales           PosSale[]
  finReceipts        FinReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
  @@index([groupId])
  @@index([name])
  @@index([priceListId])
  @@map("customers")
}

model CustomerTagLink {
