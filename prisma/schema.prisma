  trackBatches    Boolean       @default(false)
  trackExpiry     Boolean       @default(false)

  @@unique([organizationId, sku])
  @@unique([organizationId, productCode])
  @@index([organizationId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([name])
  @@map("products")
}

model ProductVariant {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  name           String
  sku            String
  attributes     Json?
  purchasePrice  Decimal?     @db.Decimal(18, 4)
  sellingPrice   Decimal?     @db.Decimal(18, 4)
  status         MasterStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([productId])
  @@map("product_variants")
}

model ProductBarcode {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  barcode        String
  isPrimary      Boolean      @default(false)
  /// Optional symbology hint for label printing (e.g. CODE128)
  symbology      String       @default("CODE128")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([productId])
  @@map("product_barcodes")
}

enum BarcodeScanSource {
  MANUAL
  CAMERA
}

enum BarcodeScanResult {
  FOUND
  NOT_FOUND
}

/// Audit log of barcode lookups from the inventory barcode screen.
model BarcodeScan {
  id             String            @id @default(uuid())
  organizationId String
  barcode        String
  source         BarcodeScanSource
  result         BarcodeScanResult
  productId      String?
  productName    String?
  userId         String?
  createdAt      DateTime          @default(now())

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, barcode])
  @@index([organizationId, result])
  @@map("barcode_scans")
}

model ProductPriceHistory {
  id             String       @id @default(uuid())
  organizationId String
  productId      String
  purchasePrice  Decimal      @db.Decimal(18, 4)
  sellingPrice   Decimal      @db.Decimal(18, 4)
  note           String?
  changedByUserId String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
  @@map("product_price_history")
}

// ----------------------------------------------------
// CRM & CUSTOMERS (Phase 06) — tenant-scoped
// ----------------------------------------------------

