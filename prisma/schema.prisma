/// Foundation ledger for balances, payments, and customer statements (sales module will post here later).
model CustomerLedgerEntry {
  id             String             @id @default(uuid())
  organizationId String
  customerId     String
  type           CustomerLedgerType
  amount         Decimal            @db.Decimal(18, 4)
  /// Positive amount increases receivable (debit); payments are stored positive with type PAYMENT (credit).
  direction      String             @default("DEBIT") // DEBIT | CREDIT
  reference      String?
  referenceType  String?
  referenceId    String?
  note           String?
  entryDate      DateTime           @default(now())
  createdByUserId String?
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([entryDate])
  @@index([type])
  @@map("customer_ledger_entries")
}

// ----------------------------------------------------
// INVENTORY (Phase 07 foundation + Phase 08 advanced)
// Single warehouse per tenant. Stock changes ONLY via posted movements.
// Valuation: Weighted Average (WAC). FIFO enum kept for future layers.
// ----------------------------------------------------

enum InventoryMovementType {
  OPENING
  GRN_RECEIPT
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  STOCK_COUNT_ADJ
  SALES_ISSUE
  SALES_RETURN
  DAMAGED
  EXPIRED
}

enum InventoryDirection {
  IN
  OUT
}

enum StockDocStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  POSTED
  CANCELLED
  RELEASED
  CLOSED
}

enum StockReservationStatus {
  ACTIVE
  PARTIAL
  RELEASED
  CONSUMED
  CANCELLED
}

/// On-hand + reserved per product. available = onHand - reserved (computed in API).
model StockBalance {
  id               String       @id @default(uuid())
  organizationId   String
  warehouseId      String
  productId        String
  /// Empty string = product-level (no variant). Keeps unique constraint reliable.
  variantKey       String       @default("")
  productVariantId String?
  quantityOnHand   Decimal      @default(0) @db.Decimal(18, 4)
  quantityReserved Decimal      @default(0) @db.Decimal(18, 4)
  /// Weighted average unit cost (valuation). FIFO would use InventoryLot instead.
  avgUnitCost      Decimal?     @db.Decimal(18, 4)
  /// onHand * avgUnitCost cache (recomputed on movement)
  totalValue       Decimal      @default(0) @db.Decimal(18, 4)
  lastMovementAt   DateTime?
  updatedAt        DateTime     @updatedAt
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse        Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([organizationId, warehouseId, productId, variantKey])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@map("stock_balances")
}

/// Batch/expiry lots + future FIFO cost layers (quantityRemaining ready for FIFO consume).
/// Phase 08 uses lots for batch/expiry tracking; valuation remains WAC on StockBalance.
model InventoryLot {
  id                 String       @id @default(uuid())
  organizationId     String
  warehouseId        String
  productId          String
  batchNumber        String?
  expiryDate         DateTime?
  receivedAt         DateTime     @default(now())
  unitCost           Decimal      @db.Decimal(18, 4)
  quantityReceived   Decimal      @db.Decimal(18, 4)
  /// Remaining in this layer — future FIFO will consume oldest first
  quantityRemaining  Decimal      @db.Decimal(18, 4)
  sourceReferenceType String?
  sourceReferenceId  String?
  sourceLineId       String?      @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse          Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product            Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([warehouseId, productId])
  @@index([expiryDate])
  @@index([receivedAt])
  @@map("inventory_lots")
}

/// Immutable audit ledger — never edit/delete posted rows.
model InventoryMovement {
  id               String                 @id @default(uuid())
  organizationId   String
  warehouseId      String
  productId        String
  productVariantId String?
  inventoryLotId   String?
  type             InventoryMovementType
  direction        InventoryDirection
  quantity         Decimal                @db.Decimal(18, 4)
  previousBalance  Decimal                @db.Decimal(18, 4)
  resultingBalance Decimal                @db.Decimal(18, 4)
  /// Unit cost applied (IN = incoming cost; OUT = WAC at time of issue)
  unitCost         Decimal?               @db.Decimal(18, 4)
  /// previous/new avg unit cost for valuation audit
  previousAvgCost  Decimal?               @db.Decimal(18, 4)
  resultingAvgCost Decimal?               @db.Decimal(18, 4)
  totalCost        Decimal?               @db.Decimal(18, 4)
  referenceType    String
  referenceId      String
  referenceCode    String?
  /// One movement per source line — prevents duplicate posting
  sourceLineId     String                 @unique
  reason           String?
  note             String?
  postedByUserId   String?
  postedAt         DateTime               @default(now())
  createdAt        DateTime               @default(now())

  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse        Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([warehouseId])
  @@index([productId])
  @@index([referenceType, referenceId])
  @@index([postedAt])
  @@index([type])
  @@map("inventory_movements")
}

/// Authorized stock adjustment (only path to change stock outside GRN/returns/sales).
model StockAdjustment {
  id             String       @id @default(uuid())
  organizationId String
  warehouseId    String
  code           String
  reason         String
  /// MANUAL | DAMAGED | EXPIRED | OTHER
  reasonCode     String       @default("MANUAL")
  status         String       @default("DRAFT") // DRAFT | POSTED | CANCELLED
  notes          String?
  postedAt       DateTime?
  postedByUserId String?
  createdByUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines          StockAdjustmentLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id             String          @id @default(uuid())
  organizationId String
  adjustmentId   String
  productId      String
  direction      InventoryDirection
  quantity       Decimal         @db.Decimal(18, 4)
  unitCost       Decimal?        @db.Decimal(18, 4)
  note           String?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adjustment     StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([adjustmentId])
  @@map("stock_adjustment_lines")
}

model OpeningStock {
