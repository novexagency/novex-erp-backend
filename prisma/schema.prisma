model Product {
  id              String        @id @default(uuid())
  organizationId  String
  name            String
  nameAr          String?
  sku             String
  productCode     String?
  description     String?
  descriptionAr   String?
  categoryId      String?
  brandId         String?
  unitId          String
  taxRateId       String?
  purchasePrice   Decimal       @default(0) @db.Decimal(18, 4)
  sellingPrice    Decimal       @default(0) @db.Decimal(18, 4)
  minStock        Decimal       @default(0) @db.Decimal(18, 4)
  maxStock        Decimal?
  reorderLevel    Decimal?
  imageUrl        String?
  costingMethod   CostingMethod @default(WEIGHTED_AVERAGE)
  status          MasterStatus  @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand           Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit            UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)
  taxRate         TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  barcodes        ProductBarcode[]
  priceHistory    ProductPriceHistory[]
  stockBalances   StockBalance[]
  inventoryMovements InventoryMovement[]
  inventoryLots   InventoryLot[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines GoodsReceiptLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  purchaseReturnLines PurchaseReturnLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockCountLines StockCountLine[]
  openingStockLines OpeningStockLine[]
  stockIssueLines StockIssueLine[]
  stockReturnLines StockReturnLine[]
  stockReservationLines StockReservationLine[]
  priceListItems  PriceListItem[]
  customerPriceOverrides CustomerPriceOverride[]
  salesQuotationLines SalesQuotationLine[]
  salesOrderLines SalesOrderLine[]
  salesInvoiceLines SalesInvoiceLine[]
  salesReturnLines SalesReturnLine[]
  posSaleLines    PosSaleLine[]
