// ----------------------------------------------------
// OPERATIONS: TASKS, PROJECTS, ASSETS & MAINTENANCE (Phase 15)
// Operational budgets/costs only — no automatic GL posting.
// ----------------------------------------------------

enum OpsTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum OpsTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum OpsProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum OpsAssetStatus {
  ACTIVE
  IN_REPAIR
  RETIRED
  DISPOSED
}

enum OpsMaintenanceType {
  PREVENTIVE
  CORRECTIVE
}

enum OpsMaintenanceStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model OpsTask {
  id             String         @id @default(uuid())
  organizationId String
  code           String
  title          String
  description    String?
  priority       OpsTaskPriority @default(MEDIUM)
  status         OpsTaskStatus  @default(TODO)
  progressPct    Int            @default(0)
  dueAt          DateTime?
  projectId      String?
  milestoneId    String?
  createdByUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        OpsProject?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone      OpsMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees      OpsTaskAssignee[]
  comments       OpsTaskComment[]
  events         OpsTaskEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([dueAt])
  @@index([projectId])
  @@map("ops_tasks")
}

model OpsTaskAssignee {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  employeeId     String
  isPrimary      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           OpsTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@index([organizationId])
  @@index([employeeId])
  @@map("ops_task_assignees")
}

model OpsTaskComment {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  employeeId     String?
  authorUserId   String?
  body           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           OpsTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee       Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([taskId])
  @@map("ops_task_comments")
}

model OpsTaskEvent {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  action         String
  actorUserId    String?
  note           String?
  at             DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           OpsTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId])
  @@map("ops_task_events")
}

model OpsProject {
  id             String           @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  description    String?
  status         OpsProjectStatus @default(PLANNING)
  managerEmployeeId String?
  startDate      DateTime?
  endDate        DateTime?
  budgetAmount   Decimal          @default(0) @db.Decimal(18, 4)
  actualCost     Decimal          @default(0) @db.Decimal(18, 4)
  progressPct    Int              @default(0)
  currency       String           @default("EGP")
  createdByUserId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager        Employee?        @relation("ProjectManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  members        OpsProjectMember[]
  milestones     OpsMilestone[]
  tasks          OpsTask[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@map("ops_projects")
}

model OpsProjectMember {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  employeeId     String
  roleLabel      String?
  joinedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        OpsProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
  @@index([organizationId])
  @@map("ops_project_members")
}

model OpsMilestone {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  code           String
  name           String
  dueAt          DateTime?
  completedAt    DateTime?
  progressPct    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        OpsProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks          OpsTask[]

  @@unique([projectId, code])
  @@index([organizationId])
  @@map("ops_milestones")
}

model OpsAssetCategory {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets         OpsAsset[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("ops_asset_categories")
}

model OpsAsset {
  id             String         @id @default(uuid())
  organizationId String
  code           String
  name           String
  nameAr         String?
  categoryId     String?
  purchaseDate   DateTime?
  purchaseCost   Decimal        @default(0) @db.Decimal(18, 4)
  status         OpsAssetStatus @default(ACTIVE)
  departmentId   String?
  assignedEmployeeId String?
  locationNote   String?
  notes          String?
  createdByUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       OpsAssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  department     Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedEmployee Employee?    @relation("AssetAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  documents      OpsAssetDocument[]
  events         OpsAssetEvent[]
  maintenanceRequests OpsMaintenanceRequest[]
  maintenanceSchedules OpsMaintenanceSchedule[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([categoryId])
  @@map("ops_assets")
}

model OpsAssetDocument {
  id             String   @id @default(uuid())
  organizationId String
  assetId        String
  title          String
  publicId       String
  secureUrl      String
  fileName       String?
  bytes          Int?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset          OpsAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assetId])
  @@map("ops_asset_documents")
}

model OpsAssetEvent {
  id             String   @id @default(uuid())
  organizationId String
  assetId        String
  action         String
  note           String?
  actorUserId    String?
  at             DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset          OpsAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assetId])
  @@map("ops_asset_events")
}

model OpsMaintenanceRequest {
  id             String               @id @default(uuid())
  organizationId String
  code           String
  assetId        String
  type           OpsMaintenanceType   @default(CORRECTIVE)
  status         OpsMaintenanceStatus @default(OPEN)
  title          String
  description    String?
  costAmount     Decimal              @default(0) @db.Decimal(18, 4)
  scheduledAt    DateTime?
  completedAt    DateTime?
  responsibleEmployeeId String?
  createdByUserId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset          OpsAsset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  responsible    Employee?            @relation("MaintenanceResponsible", fields: [responsibleEmployeeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([assetId])
  @@index([status])
  @@map("ops_maintenance_requests")
}

model OpsMaintenanceSchedule {
  id             String   @id @default(uuid())
  organizationId String
  assetId        String
  title          String
  intervalDays   Int      @default(90)
  nextDueAt      DateTime
  lastDoneAt     DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset          OpsAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([assetId])
  @@index([nextDueAt])
  @@map("ops_maintenance_schedules")
}

// ─────────────────────────────────────────────
// Phase 16 — Approval workflows, documents, notifications
// ─────────────────────────────────────────────

enum WorkflowDocumentType {
  PURCHASE_REQUEST
  PURCHASE_ORDER
  SALES_DISCOUNT
  SALES_RETURN
  EXPENSE
  PAYMENT
  STOCK_ADJUSTMENT
  LEAVE_REQUEST
  PAYROLL_RUN
  MANUAL_JOURNAL
}

enum WorkflowApproverMode {
  ROLE
  USER
  MANAGER
}

enum ApprovalInstanceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ESCALATED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  DELEGATED
  ESCALATED
  STARTED
  LEVEL_SKIPPED
}

enum DocVisibility {
  TENANT
  RESTRICTED
}

enum NotificationType {
  APPROVAL_REQUEST
  APPROVAL_REJECTED
  APPROVAL_APPROVED
  TASK_ASSIGNED
  OVERDUE_ACTIVITY
  LOW_STOCK
  DOCUMENT_EXPIRING
  REPORT_READY
  SYSTEM
}

enum ReportScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReportScheduleRange {
  PREVIOUS_DAY
  PREVIOUS_WEEK
  PREVIOUS_MONTH
}

enum ReportExportFormat {
  CSV
  XLSX
  PDF
}

enum ReportScheduleRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

/// Scheduled report delivery (in-app notification + downloadable export file).
model ReportSchedule {
  id                String                   @id @default(uuid())
  organizationId    String
  name              String
  /// Canonical path e.g. /tenant/reports/sales/by-product
  reportPath        String
  format            ReportExportFormat       @default(XLSX)
  frequency         ReportScheduleFrequency
  hour              Int                      @default(8)
  dayOfMonth        Int?
  dayOfWeek         Int?
  range             ReportScheduleRange
  recipientUserIds  String[]
  isActive          Boolean                  @default(true)
  createdByUserId   String?
  lastRunAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs              ReportScheduleRun[]

  @@index([organizationId, isActive])
  @@map("report_schedules")
}

model ReportScheduleRun {
  id             String                   @id @default(uuid())
  organizationId String
  scheduleId     String
  startedAt      DateTime                 @default(now())
  finishedAt     DateTime?
  status         ReportScheduleRunStatus  @default(PENDING)
  filePublicId   String?
  fileSecureUrl  String?
  fileName       String?
  fileBytes      Int?
  error          String?
  triggeredBy    String?

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedule       ReportSchedule           @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([organizationId, scheduleId])
  @@index([organizationId, startedAt])
  @@map("report_schedule_runs")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model WorkflowDefinition {
  id               String                @id @default(uuid())
  organizationId   String
  documentType     WorkflowDocumentType
  name             String
  isActive         Boolean               @default(true)
  escalationHours  Int?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps            WorkflowStep[]
  instances        ApprovalInstance[]

  @@unique([organizationId, documentType, name])
  @@index([organizationId, documentType, isActive])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id               String               @id @default(uuid())
  organizationId   String
  definitionId     String
  level            Int
  name             String
  approverMode     WorkflowApproverMode @default(USER)
  roleId           String?
  userId           String?
  amountLimit      Decimal?             @db.Decimal(18, 4)
  canDelegate      Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition       WorkflowDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, level])
  @@index([organizationId])
  @@map("workflow_steps")
}

model ApprovalInstance {
  id                   String                  @id @default(uuid())
  organizationId       String
  definitionId         String
  documentType         WorkflowDocumentType
  documentId           String
  amount               Decimal?                @db.Decimal(18, 4)
  status               ApprovalInstanceStatus  @default(PENDING)
  currentLevel         Int                     @default(1)
  currentAssigneeIds   Json                    @default("[]")
  submittedByUserId    String?
  submittedAt          DateTime                @default(now())
  completedAt          DateTime?
  escalationDueAt      DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition           WorkflowDefinition      @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  actions              ApprovalAction[]

  @@index([organizationId, status])
  @@index([organizationId, documentType, documentId])
  @@map("approval_instances")
}

model ApprovalAction {
  id               String             @id @default(uuid())
  organizationId   String
  instanceId       String
  level            Int
  action           ApprovalActionType
  actorUserId      String?
  delegateToUserId String?
  comment          String?
  rejectionReason  String?
  at               DateTime           @default(now())

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instance         ApprovalInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([instanceId])
  @@map("approval_actions")
}

model ApprovalDelegation {
  id               String                @id @default(uuid())
  organizationId   String
  fromUserId       String
  toUserId         String
  documentType     WorkflowDocumentType?
  validFrom        DateTime              @default(now())
  validTo          DateTime?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, fromUserId, isActive])
  @@index([organizationId, toUserId, isActive])
  @@map("approval_delegations")
}

model DocCategory {
  id               String   @id @default(uuid())
  organizationId   String
  code             String
  name             String
  nameAr           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents        RepoDocument[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("doc_categories")
}

model DocTag {
  id               String   @id @default(uuid())
  organizationId   String
  name             String
  createdAt        DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents        DocTagOnDocument[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("doc_tags")
}

model RepoDocument {
  id               String        @id @default(uuid())
  organizationId   String
  title            String
  categoryId       String?
  visibility       DocVisibility @default(TENANT)
  ownerUserId      String?
  currentVersion   Int           @default(0)
  expiresAt        DateTime?
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         DocCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]
  access           DocumentAccess[]
  links            DocumentLink[]
  tags             DocTagOnDocument[]

  @@index([organizationId])
  @@index([categoryId])
  @@index([title])
  @@map("repo_documents")
}

model DocumentVersion {
  id               String       @id @default(uuid())
  organizationId   String
  documentId       String
  version          Int
  publicId         String
  secureUrl        String
  fileName         String?
  bytes            Int?
  uploadedByUserId String?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         RepoDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([organizationId])
  @@map("document_versions")
}

model DocumentAccess {
  id               String       @id @default(uuid())
  organizationId   String
  documentId       String
  userId           String?
  roleId           String?
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         RepoDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
  @@map("document_access")
}

model DocumentLink {
  id               String       @id @default(uuid())
  organizationId   String
  documentId       String
  entityType       String
  entityId         String
  createdAt        DateTime     @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         RepoDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("document_links")
}

model DocTagOnDocument {
  id               String       @id @default(uuid())
  organizationId   String
  documentId       String
  tagId            String

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document         RepoDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag              DocTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([documentId, tagId])
  @@index([organizationId])
  @@map("doc_tag_on_documents")
}

model Notification {
  id               String               @id @default(uuid())
  organizationId   String
  userId           String
  type             NotificationType
  title            String
  body             String?
  entityType       String?
  entityId         String?
  severity         NotificationSeverity @default(INFO)
  readAt           DateTime?
  createdAt        DateTime             @default(now())

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, type])
  @@map("notifications")
}
