generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Global & Auth Models
// ----------------------------------------------------

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  name             String
  phone            String?
  avatarUrl        String?
  isSuperAdmin     Boolean              @default(false)
  isActive         Boolean              @default(true)
  failedLoginCount Int                  @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  refreshTokens       RefreshToken[]
  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  authEvents          AuthEvent[]
  passwordResetTokens PasswordResetToken[]
  /// Optional link from tenant HR Employee profiles (Phase 13)
  employeeProfiles    Employee[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_CONFIRM
  SESSION_REVOKE
  ACCOUNT_ACTIVATED
  ACCOUNT_DEACTIVATED
}

/// Login / auth history (success + failures). Never store passwords or raw tokens.
model AuthEvent {
  id             String        @id @default(uuid())
  userId         String?
  organizationId String?
  emailAttempt   String?
  type           AuthEventType
  ipAddress      String?
  userAgent      String?
  meta           Json?
  createdAt      DateTime      @default(now())

  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@map("auth_events")
}

/// Admin/internal password reset foundation (no email/WhatsApp delivery in Phase 02).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------
// Multi-Tenancy & Enterprise Hierarchy
// ----------------------------------------------------

/// Canonical SaaS tenant. `id` is the unique tenant ID used across all tenant-owned records.
model Organization {
  id                 String                @id @default(uuid())
  name               String
  code               String                @unique
  taxNumber          String?
  commercialRegister String?
  baseCurrency       String                @default("EGP")
  logoUrl            String?
  website            String?
  /// UI / business default locale for this tenant (system is bilingual: en + ar)
  defaultLocale      LocaleCode            @default(en)
  timezone           String                @default("Africa/Cairo")
  /// Company profile (Phase 03)
  addressLine1       String?
  addressLine2       String?
  city               String?
  country            String                @default("Egypt")
  postalCode         String?
  phonePrimary       String?
  phoneSecondary     String?
  emailContact       String?
  businessActivity   String?
  description        String?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  branches           Branch[]
  departments        Department[]
  members            OrganizationMember[]
  roles              Role[]
  settings           OrganizationSetting[]
  documentSequences  DocumentSequence[]
  auditLogs          AuditLog[]
  subscriptions      TenantSubscription[]
  entitlements       TenantEntitlement[]
  modules            TenantModule[]
  activities         TenantActivity[]
  systemConfig       TenantSystemConfig?
  warehouses         Warehouse[]
  warehouseLocations WarehouseLocation[]
  // Master data (Phase 05)
  productCategories  ProductCategory[]
  brands             Brand[]
  units              UnitOfMeasure[]
  unitConversions    UnitConversion[]
  taxRates           TaxRate[]
  paymentMethods     PaymentMethod[]
  expenseCategories  ExpenseCategory[]
  currencies         Currency[]
  jobTitles          JobTitle[]
  products           Product[]
  productVariants    ProductVariant[]
  productBarcodes    ProductBarcode[]
  barcodeScans       BarcodeScan[]
  productPriceHistory ProductPriceHistory[]
  // CRM (Phase 06)
  customerCategories CustomerCategory[]
  customerGroups     CustomerGroup[]
  customerTags       CustomerTag[]
  customers          Customer[]
  customerTagLinks   CustomerTagLink[]
  customerNotes      CustomerNote[]
  customerInteractions CustomerInteraction[]
  customerFollowUps  CustomerFollowUp[]
  salesOpportunities SalesOpportunity[]
  customerLedgerEntries CustomerLedgerEntry[]
  // Procurement & inventory foundation (Phase 07)
  supplierCategories SupplierCategory[]
  suppliers          Supplier[]
  supplierLedgerEntries SupplierLedgerEntry[]
  purchaseRequests   PurchaseRequest[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  purchaseOrderAttachments PurchaseOrderAttachment[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  purchaseInvoices   PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  supplierPayments   SupplierPayment[]
  supplierPaymentAllocations SupplierPaymentAllocation[]
  purchaseReturns    PurchaseReturn[]
  purchaseReturnLines PurchaseReturnLine[]
  stockBalances      StockBalance[]
  inventoryMovements InventoryMovement[]
  stockAdjustments   StockAdjustment[]
  stockAdjustmentLines StockAdjustmentLine[]
  // Inventory Phase 08
  inventoryLots      InventoryLot[]
  stockCounts        StockCount[]
  stockCountLines    StockCountLine[]
  openingStocks      OpeningStock[]
  openingStockLines  OpeningStockLine[]
  stockIssues        StockIssue[]
  stockIssueLines    StockIssueLine[]
  stockReturns       StockReturn[]
  stockReturnLines   StockReturnLine[]
  stockReservations  StockReservation[]
  stockReservationLines StockReservationLine[]
  // Sales (Phase 09)
  priceLists         PriceList[]
  priceListItems     PriceListItem[]
  customerPriceOverrides CustomerPriceOverride[]
  discountRules      DiscountRule[]
  salesQuotations    SalesQuotation[]
  salesQuotationLines SalesQuotationLine[]
  salesOrders        SalesOrder[]
  salesOrderLines    SalesOrderLine[]
  salesInvoices      SalesInvoice[]
  salesInvoiceLines  SalesInvoiceLine[]
  customerReceipts   CustomerReceipt[]
  customerReceiptAllocations CustomerReceiptAllocation[]
  salesReturns       SalesReturn[]
  salesReturnLines   SalesReturnLine[]
  // POS (Phase 10)
  posReceiptConfigs  PosReceiptConfig[]
  cashierSessions    CashierSession[]
  cashMovements      CashMovement[]
  posSales           PosSale[]
  posSaleLines       PosSaleLine[]
  posPayments        PosPayment[]
  posSaleEvents      PosSaleEvent[]
  // Finance / Treasury (Phase 11)
  cashboxes          Cashbox[]
  bankAccounts       BankAccount[]
  treasuryMovements  TreasuryMovement[]
  treasuryTransfers  TreasuryTransfer[]
  costCenters        CostCenter[]
  expenses           Expense[]
  expenseAttachments ExpenseAttachment[]
  recurringExpenses  RecurringExpense[]
  finReceipts        FinReceipt[]
  finReceiptAllocations FinReceiptAllocation[]
  finPayments        FinPayment[]
  finPaymentAllocations FinPaymentAllocation[]
  // Accounting / GL (Phase 12)
  glAccounts         GlAccount[]
  fiscalYears        FiscalYear[]
  accountingPeriods  AccountingPeriod[]
  accountingPostingRules AccountingPostingRule[]
  journalEntries     JournalEntry[]
  journalLines       JournalLine[]
  journalAuditLogs   JournalAuditLog[]
  // HR (Phase 13) — tenant employees only (not NOVEX platform staff)
  employees          Employee[]
  employeeCompensations EmployeeCompensation[]
  teams              Team[]
  teamMembers        TeamMember[]
  employeeDocuments  EmployeeDocument[]
  hrRequests         HrRequest[]
  hrRequestApprovals HrRequestApproval[]
  // Attendance / Leave / Payroll (Phase 14)
  workSchedules      WorkSchedule[]
  shifts             Shift[]
  employeeSchedules  EmployeeSchedule[]
  attendanceRecords  AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveTypes         LeaveType[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  leaveRequestEvents LeaveRequestEvent[]
  payrollPeriods     PayrollPeriod[]
  payrollRuns        PayrollRun[]
  payrollLines       PayrollLine[]
  payrollLineItems   PayrollLineItem[]
  salaryAdvances     SalaryAdvance[]
  // Operations (Phase 15)
  opsTasks           OpsTask[]
  opsTaskAssignees   OpsTaskAssignee[]
  opsTaskComments    OpsTaskComment[]
  opsTaskEvents      OpsTaskEvent[]
  opsProjects        OpsProject[]
  opsProjectMembers  OpsProjectMember[]
  opsMilestones      OpsMilestone[]
  opsAssets          OpsAsset[]
  opsAssetCategories OpsAssetCategory[]
  opsAssetDocuments  OpsAssetDocument[]
  opsAssetEvents     OpsAssetEvent[]
  opsMaintenanceRequests OpsMaintenanceRequest[]
  opsMaintenanceSchedules OpsMaintenanceSchedule[]
  // Workflow / Documents / Notifications (Phase 16)
  workflowDefinitions    WorkflowDefinition[]
  workflowSteps          WorkflowStep[]
  approvalInstances      ApprovalInstance[]
  approvalActions        ApprovalAction[]
  approvalDelegations    ApprovalDelegation[]
  docCategories          DocCategory[]
  docTags                DocTag[]
  repoDocuments          RepoDocument[]
  documentVersions       DocumentVersion[]
  documentAccesses       DocumentAccess[]
  documentLinks          DocumentLink[]
  documentTagLinks       DocTagOnDocument[]
  notifications          Notification[]
  reportSchedules        ReportSchedule[]
  reportScheduleRuns     ReportScheduleRun[]
  // Platform control (Phase 18)
  supportAccessGrants    PlatformSupportAccess[]

  @@map("organizations")
}

enum LocaleCode {
  en
  ar
}

enum BranchType {
  HEADQUARTERS
  FACTORY
  WAREHOUSE
  RETAIL_STORE
  OFFICE
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String
  type           BranchType   @default(OFFICE)
  address        String?
  city           String?
  country        String       @default("Egypt")
  phone          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberRoles    MemberRole[]
  employees      Employee[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("branches")
}

model Department {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganizationMember[]
  employees      Employee[]
  teams          Team[]
  assets         OpsAsset[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("departments")
}

// ----------------------------------------------------
// Dynamic Role-Based Access Control (RBAC)
// ----------------------------------------------------

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  departmentId   String?
  jobTitle       String?
  status         MemberStatus @default(ACTIVE)
  joinedAt       DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  memberRoles    MemberRole[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Permission {
  id              String           @id @default(uuid())
  module          String
  action          String
  code            String           @unique
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id              String           @id @default(uuid())
  organizationId  String?
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model MemberRole {
  id         String             @id @default(uuid())
  memberId   String
  roleId     String
  branchId   String?
  assignedAt DateTime           @default(now())

  member     OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branch     Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([memberId, roleId, branchId])
  @@index([memberId])
  @@index([roleId])
  @@map("member_roles")
}

// ----------------------------------------------------
// Governance, Sequences & Settings
// ----------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  FAILED_LOGIN
  PASSWORD_RESET
  PERMISSION_CHANGE
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  action         AuditAction
  entity         String
  entityId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model DocumentSequence {
  id             String       @id @default(uuid())
  organizationId String
  module         String
  prefix         String
  year           Int?
  currentNumber  Int          @default(0)
  padding        Int          @default(4)
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, module, year])
  @@index([organizationId])
  @@map("document_sequences")
}

model OrganizationSetting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          String
  type           String       @default("string")
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("organization_settings")
}

/// Tenant-specific system configuration (never shared across companies).
model TenantSystemConfig {
  id                   String     @id @default(uuid())
  organizationId       String     @unique
  currency             String     @default("EGP")
  timezone             String     @default("Africa/Cairo")
  dateFormat           String     @default("DD/MM/YYYY")
  numberFormat         String     @default("1,234.56")
  fiscalYearStartMonth Int        @default(1)
  fiscalYearStartDay   Int        @default(1)
  defaultLocale        LocaleCode @default(en)
  /// auto | ltr | rtl — auto follows defaultLocale (ar => rtl)
  textDirection        String     @default("auto")
  taxEnabled           Boolean    @default(true)
  defaultTaxRate       Decimal?   @db.Decimal(7, 4)
  taxRegistrationNumber String?
  taxInclusivePricing  Boolean    @default(false)
  invoicePrefix        String     @default("INV")
  invoicePadding       Int        @default(4)
  documentPadding      Int        @default(4)
  /// Phase 08 — allow on-hand to go negative when posting outbound movements
  allowNegativeStock   Boolean    @default(false)
  /// Default product costing for valuation (FIFO reserved for future accounting)
  defaultCostingMethod CostingMethod @default(WEIGHTED_AVERAGE)
  /// Max concurrently active branches (HQ counts). Frontend locks add when used >= limit.
  maxActiveBranches    Int        @default(5)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("tenant_system_configs")
}

/// Single-warehouse product mode: only one ACTIVE warehouse allowed per tenant (enforced in service).
model Warehouse {
  id               String              @id @default(uuid())
  organizationId   String
  name             String
  code             String
  address          String?
  city             String?
  country          String              @default("Egypt")
  managerUserId    String?
  managerName      String?
  isActive         Boolean             @default(true)
  isDefault        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locations        WarehouseLocation[]
  stockBalances    StockBalance[]
  inventoryMovements InventoryMovement[]
  inventoryLots    InventoryLot[]
  goodsReceipts    GoodsReceipt[]
  purchaseReturns  PurchaseReturn[]
  stockAdjustments StockAdjustment[]
  stockCounts      StockCount[]
  openingStocks    OpeningStock[]
  stockIssues      StockIssue[]
  stockReturns     StockReturn[]
  stockReservations StockReservation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("warehouses")
}

model WarehouseLocation {
  id             String       @id @default(uuid())
  organizationId String
  warehouseId    String
  name           String
  code           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("warehouse_locations")
}

// ----------------------------------------------------
// PLATFORM namespace — NOVEX Central Control (not tenant business)
// Kept logically separated from tenant employees / tenant ops.
// ----------------------------------------------------

enum PlatformStaffRole {
  PLATFORM_ADMIN
  PLATFORM_SUPPORT
  PLATFORM_BILLING
}

/// NOVEX internal staff for the Central Control Panel.
/// Must never be treated as a tenant OrganizationMember / employee.
model PlatformStaff {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  role         PlatformStaffRole @default(PLATFORM_SUPPORT)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("platform_staff")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ----------------------------------------------------
// TENANT SaaS namespace — subscription, modules, activity
// All rows are scoped by organizationId (= tenantId).
// ----------------------------------------------------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model TenantSubscription {
  id                String             @id @default(uuid())
  organizationId    String
  planCode          String             @default("standard")
  status            SubscriptionStatus @default(TRIAL)
  seats             Int                @default(10)
  startsAt          DateTime           @default(now())
  endsAt            DateTime?
  trialEndsAt       DateTime?
  gracePeriodEndsAt DateTime?
  renewedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
  @@map("tenant_subscriptions")
}

/// Explicit, time-bound support access into a tenant (never silent bypass).
model PlatformSupportAccess {
  id               String    @id @default(uuid())
  organizationId   String
  staffUserId      String
  reason           String
  authorizedByUserId String?
  scopes           Json?
  startsAt         DateTime  @default(now())
  endsAt           DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([staffUserId])
  @@index([endsAt])
  @@map("platform_support_access")
}

model PlatformSupportAccessLog {
  id               String   @id @default(uuid())
  organizationId   String
  staffUserId      String
  accessId         String?
  action           String
  reason           String?
  meta             Json?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([organizationId])
  @@index([staffUserId])
  @@index([createdAt])
  @@map("platform_support_access_logs")
}

model TenantEntitlement {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  enabled        Boolean      @default(true)
  limits         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("tenant_entitlements")
}

model TenantModule {
  id             String       @id @default(uuid())
  organizationId String
  moduleCode     String
  enabled        Boolean      @default(true)
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleCode])
  @@index([organizationId])
  @@map("tenant_modules")
}

model TenantActivity {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entity         String?
  entityId       String?
  meta           Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("tenant_activities")
}

// ----------------------------------------------------
// MASTER DATA (Phase 05) — all tenant-scoped
// ----------------------------------------------------

enum CostingMethod {
  FIFO
  WEIGHTED_AVERAGE
  STANDARD
}

enum MasterStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ProductCategory {
  id             String            @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  nameAr         String?
  code           String?
  description    String?
  descriptionAr  String?
  status         MasterStatus      @default(ACTIVE)
  sortOrder      Int               @default(0)
  archivedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[] @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
  @@index([status])
  @@map("product_categories")
}

model Brand {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  nameAr         String?
  code           String?
  status         MasterStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("brands")
}

model UnitOfMeasure {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  nameAr         String?
  code           String
  symbol         String?
  isSystem       Boolean          @default(false)
  status         MasterStatus     @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  conversionsFrom UnitConversion[] @relation("FromUnit")
  conversionsTo   UnitConversion[] @relation("ToUnit")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("units_of_measure")
}

model UnitConversion {
  id             String       @id @default(uuid())
  organizationId String
  fromUnitId     String
  toUnitId       String
  /// Multiply qty in fromUnit by factor to get qty in toUnit
  factor         Decimal      @db.Decimal(18, 6)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromUnit       UnitOfMeasure @relation("FromUnit", fields: [fromUnitId], references: [id], onDelete: Cascade)
  toUnit         UnitOfMeasure @relation("ToUnit", fields: [toUnitId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromUnitId, toUnitId])
  @@index([organizationId])
  @@map("unit_conversions")
}

model TaxRate {
  id             String       @id @default(uuid())
