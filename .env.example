NODE_ENV=development
PORT=4000

# PostgreSQL (Prisma). Prefer direct URL for migrations; pooled for serverless runtimes.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&connect_timeout=30"

# JWT — use a long random secret in production (min 32 chars, never "change-me")
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7

# Cookies — production cross-site (Vercel → API host): COOKIE_SECURE=true, COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_COOKIE_NAME=novex_access
REFRESH_COOKIE_NAME=novex_refresh
TENANT_COOKIE_NAME=novex_tenant

# Frontend origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,https://novexerp.vercel.app

# Seed admin (local / first bootstrap only — rotate in production)
SEED_ADMIN_EMAIL=admin@novex.com
SEED_ADMIN_PASSWORD=123456
SEED_ADMIN_NAME=Novex Admin

# Cloudinary (media uploads) — never commit real secrets
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=novex-erp

# M2M key for novex_admin_back → /api/v1/platform/* (header X-Platform-Key)
PLATFORM_SERVICE_KEY=change-me-platform-service-key-min-16

# Logical backups (Phase 21)
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30
